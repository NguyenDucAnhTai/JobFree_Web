# Copy file này thành .env (hoặc .env.local) rồi điền giá trị thật.
# Lưu ý: mọi biến VITE_* đều bị nhúng vào bundle phía client,
# KHÔNG đặt secret (API key bí mật, mật khẩu...) vào biến VITE_*.

# URL trang admin, dùng cho nút "Admin Portal" trên landing page
VITE_ADMIN_URL=http://localhost:5174/admin
